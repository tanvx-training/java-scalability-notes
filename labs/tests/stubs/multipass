#!/bin/bash
# Stub multipass: ghi lời gọi vào $MP_LOG, trả lời theo MP_LIST / MP_FAIL.
# MP_LIST: các dòng csv (không header). MP_FAIL: tên lệnh con cần giả lỗi, thoát mã MP_FAIL_RC (mặc định 2).
[ -n "${MP_LOG:-}" ] && echo "$*" >> "$MP_LOG"
sub="${1:-}"
if [ -n "${MP_FAIL:-}" ] && [ "$MP_FAIL" = "$sub" ]; then
  echo "stub: $sub failed" >&2; exit "${MP_FAIL_RC:-2}"
fi
run="${MP_LOG:-/dev/null}.run"
case "$sub" in
  info)
    # <VM>.<snapshot> chỉ tồn tại nếu có trong MP_SNAPS (các từ cách nhau bằng khoảng trắng)
    for a in "$@"; do
      case "$a" in *.*) case " ${MP_SNAPS:-} " in *" $a "*) ;; *) echo "stub: no snapshot $a" >&2; exit 2 ;; esac ;; esac
    done
    ;;
  list)
    echo "Name,State,IPv4,IPv6,Release,AllIPv4"
    [ -n "${MP_LIST:-}" ] && printf '%s\n' "$MP_LIST"
    [ -f "$run" ] && cat "$run"
    ;;
  exec)
    # multipass 1.16.3 thật treo (quay CPU) khi stdout hoặc stderr là /dev/null: ghi dấu để test bắt.
    # fd_id: "thiết bị:inode" của một tệp. Thử dạng GNU `stat -c` (Linux CI) trước: trên GNU, `stat -f` là
    # thông tin HỆ TỆP và vẫn trả 0, nên thử nó trước sẽ so nhầm. BSD stat (macOS) không có -c, rơi sang -f.
    fd_id() { stat -L -c '%d:%i' "$1" 2>/dev/null || stat -L -f '%d:%i' "$1" 2>/dev/null; }
    if [ -n "${MP_LOG:-}" ]; then
      null_id="$(fd_id /dev/null)"
      err_id="$(fd_id /dev/fd/3 3>&2)"                 # fd 2 bên trong $(…) vẫn là stderr thật
      { out_id="$(fd_id /dev/fd/4)"; } 4>&1            # fd 4 = stdout thật, lấy ngoài $(…)
      [ "$err_id" = "$null_id" ] && echo "EXEC-STDERR-NULL $2" >> "$MP_LOG"
      [ "$out_id" = "$null_id" ] && echo "EXEC-STDOUT-NULL $2" >> "$MP_LOG"
    fi
    # MP_NOCTR: các tên VM chưa có containerd (`command -v ctr` thất bại)
    case "$*" in *"command -v ctr"*) for n in ${MP_NOCTR:-}; do [ "$2" = "$n" ] && exit 1; done ;; esac
    # MP_EXEC_RUN=1: chạy thật phần sau `--` trên máy test, trả mã thoát của nó. multipass 1.16.3 thật
    # chạy lại lệnh mãi khi lệnh trong VM thoát mã 4 (trùng mã "retry" của nó): ghi dấu để test bắt.
    if [ "${MP_EXEC_RUN:-}" = 1 ]; then
      while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
      shift
      rc=0; "$@" || rc=$?
      [ "$rc" -eq 4 ] && [ -n "${MP_LOG:-}" ] && echo "EXEC-RC-4" >> "$MP_LOG"
      exit "$rc"
    fi
    ;;
  launch)
    n=""; while [ $# -gt 0 ]; do [ "$1" = "--name" ] && n="$2"; shift; done
    [ -n "${MP_LOG:-}" ] && echo "$n,Running,10.0.0.9,,Ubuntu 24.04 LTS,\"\"" >> "$run"
    ;;
  start)
    shift; for n in "$@"; do [ -n "${MP_LOG:-}" ] && echo "$n,Running,10.0.0.9,,Ubuntu 24.04 LTS,\"\"" >> "$run"; done
    ;;
esac
exit 0
