# s02 — đường đi của một lần đăng nhập Basic vào order, sau khi sửa st02-no-prefix.
# Lấy bằng breakpoint trong BasicAuthenticationFilter.doFilterInternal rồi Step Into authenticate().
MANAGER_WRAPPER=ObservationAuthenticationManager
LOCAL_PROVIDERS=AnonymousAuthenticationProvider
PROVIDER=DaoAuthenticationProvider
PROVIDER_IN=parent
USER_DETAILS_SERVICE=InMemoryUserDetailsManager
PASSWORD_ENCODER=DelegatingPasswordEncoder
