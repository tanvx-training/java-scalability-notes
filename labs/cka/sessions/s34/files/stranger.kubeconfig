apiVersion: v1
kind: Config
preferences: {}
clusters:
- name: prod
  cluster:
    server: https://k8s-prod.shop.example:6443
    certificate-authority: /etc/shop/pki/prod-ca.crt
- name: staging
  cluster:
    server: https://10.20.30.40:6443
    certificate-authority: /etc/shop/pki/staging-ca.crt
users:
- name: prod-admin
  user:
    client-certificate: /etc/shop/pki/prod-admin.crt
    client-key: /etc/shop/pki/prod-admin.key
- name: auditor
  user:
    token: lab-s34-not-a-real-token
- name: dev
  user:
    client-certificate: /etc/shop/pki/dev.crt
    client-key: /etc/shop/pki/dev.key
contexts:
- name: prod
  context:
    cluster: prod
    user: prod-admin
    namespace: default
- name: dev
  context:
    cluster: staging
    user: dev
    namespace: shop
- name: audit
  context:
    cluster: staging
    user: auditor
    namespace: billing
current-context: audit
